<?xml version="1.0"?>
<Container version="2">
  <Name>netpulse</Name>
  <Repository>ghcr.io/barroso88/netpulse:latest</Repository>
  <Registry>https://ghcr.io/barroso88/netpulse</Registry>
  <Network>host</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>true</Privileged>
  <Support>https://github.com/Barroso88/netpulse</Support>
  <Project>https://github.com/Barroso88/netpulse</Project>
  <Overview>NetPulse - Monitor de Rede em Tempo Real, Agentes Autónomos &amp; Dashboard Cyber Glass 2.0. Utiliza modo de rede 'host' para auditar a tabela ARP física e monitorizar os equipamentos da sua rede local.</Overview>
  <Category>Network:Management Network:Other</Category>
  <WebUI>http://[IP]:[PORT:8888]</WebUI>
  <TemplateURL/>
  <Icon>https://raw.githubusercontent.com/Barroso88/netpulse/main/static/icon.svg</Icon>
  <ExtraParams/>
  <PostArgs/>
  <CPUset/>
  <DateInstalled/>
  <DonateText/>
  <DonateLink/>
  <Requires/>
  <Config Name="WebUI Port" Target="8888" Default="8888" Mode="tcp" Description="Porta da Interface Web (padrão 8888)" Type="Port" Display="always" Required="true" Mask="false">8888</Config>
  <Config Name="App Data" Target="/data" Default="/mnt/user/appdata/netpulse" Mode="rw" Description="Diretoria persistente para a base de dados SQLite (netpulse.db)" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/netpulse</Config>
</Container>
